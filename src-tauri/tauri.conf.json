{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchivistPro",
  "version": "3.6.0",
  "identifier": "com.archivistpro.h3",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArchivistPro",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:5173",
        "connect-src": "ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "font-src": "'self' http://localhost:5173",
        "img-src": "'self' http://localhost:5173 data: blob:",
        "media-src": "'self' asset: http://asset.localhost http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
